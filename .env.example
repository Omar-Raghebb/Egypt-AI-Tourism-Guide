# =============================================================================
# RehlaAI Hybrid RAG — environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# =============================================================================

# --- Groq LLM (required for generation; retrieval works without it) ----------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Check supported models at https://console.groq.com/docs/models
# (llama-3.3-70b-versatile was shut down 2026-08-16; gpt-oss-120b is current)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_TOP_P=0.9
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# --- Knowledge base ----------------------------------------------------------
# The active knowledge base is the enhanced RehlaAI JSON (THE source of truth).
KB_SINGLE_FILE=./data/rehlaai_rag_data_enhanced.json
# Optional per-landmark folder KB (legacy format); used only when
# KB_SINGLE_FILE is unset. Kept in data/egypt_landmarks_kb as a backup.
KB_PATH=./data/egypt_landmarks_kb

# --- Local embedding model ----------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# auto | cpu | cuda
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true

# --- ChromaDB (local, persistent) ---------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=rehlai_knowledge

# --- Chunking ------------------------------------------------------------------
CHUNK_SIZE=300
CHUNK_OVERLAP=45

# --- Retrieval ------------------------------------------------------------------
TOP_K=4
DENSE_TOP_K=8
SPARSE_TOP_K=8
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
STRUCTURED_WEIGHT=1.5
MIN_RELEVANCE_THRESHOLD=0.0

# --- Context construction --------------------------------------------------------
MAX_CONTEXT_CHARS=6000
MAX_CONTEXT_DOCS=8
